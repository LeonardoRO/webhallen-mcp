{
  "name": "webhallen-mcp",
  "version": "0.1.0",
  "description": "Unofficial Model Context Protocol (MCP) server for searching products on Webhallen.",
  "type": "module",
  "bin": {
    "webhallen-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test test/parse.test.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "webhallen",
    "sweden",
    "shopping"
  ],
  "author": "Leonardo Ribeiro Oliveira",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeonardoRO/webhallen-mcp.git"
  },
  "homepage": "https://github.com/LeonardoRO/webhallen-mcp#readme",
  "bugs": {
    "url": "https://github.com/LeonardoRO/webhallen-mcp/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
